# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder

WORKDIR /build

# Install CA certificates and tzdata
RUN apk add --no-cache ca-certificates tzdata

# Cache dependencies
COPY api/go.mod api/go.sum ./
RUN go mod download

# Copy source code and build statically
COPY api/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/server ./cmd/server

# Final minimal runtime image (ADR-011 specifies alpine:3.20 non-root)
FROM alpine:3.20

# Non-root user setup
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy ca-certificates, tzdata and binary from builder
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /app/server /app/server

USER appuser

EXPOSE 8080

ENTRYPOINT ["/app/server"]
