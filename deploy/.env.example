# ==============================================================================
# CGP v2 (Cây Gia Phả) Environment Configuration
# All configurations for api/internal/config/config.go
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Server listening port (internal container default: 8080)
PORT=8080

# Environment mode: dev | demo | prod
# - dev: allows MOCK_OAUTH_ENABLED, relaxed JWT checks, auto migrations
# - demo: Mode A isolation, strict fail-fast validation, requires demo JWT/DSN
# - prod: production strict fail-fast validation
APP_ENV=prod

# Mode A Demo toggle: set true for demo instances, false for production/dev
DEMO_MODE=false

# Public base URL of the web frontend (used for CORS and redirect URLs)
# Strict URL format required in demo/prod (scheme + host, no subpath)
PUBLIC_BASE_URL=http://localhost:3456

# Allowed CORS origins (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3456,http://localhost:3457

# Auto-execute database migrations and initial seed data if DB is empty
AUTO_SEED=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection DSN. Accepts either DATABASE_URL or CGP_DB_DSN.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
# NOTE for DEMO mode: the database name or DSN must contain the word 'demo' (INV-04)
DATABASE_URL=postgres://cgp_user:cgp_secure_password_2026@postgres:5432/cgp_db?sslmode=disable
CGP_DB_DSN=

# Postgres container initialization variables (used by docker-compose postgres service)
POSTGRES_USER=cgp_user
POSTGRES_PASSWORD=cgp_secure_password_2026
POSTGRES_DB=cgp_db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSIONS (JWT & COOKIES)
# ------------------------------------------------------------------------------
# JWT secret key used for signing session tokens (HMAC-SHA256)
# Must be at least 32 characters long in demo/prod mode (INV-04)
JWT_SECRET=change-me-in-prod-super-secure-jwt-secret-key-32chars-min

# JWT Issuer claim:
# Default in prod: cgp-prod
# Default in demo: cgp-demo (enforced by INV-04)
# Leave blank to use auto-derived default based on DEMO_MODE/APP_ENV
JWT_ISSUER=

# Cookie name for storing session tokens:
# Default in prod: cgp_session
# Default in demo: cgp_demo_session (enforced by INV-04)
# Leave blank to use auto-derived default based on DEMO_MODE/APP_ENV
COOKIE_NAME=

# ------------------------------------------------------------------------------
# 4. MOCK OAUTH (DEVELOPMENT ONLY)
# ------------------------------------------------------------------------------
# Enable mock OAuth login for local dev/testing without external provider credentials.
# CRITICAL SECURITY RULE (INV-04): MUST be false in demo and prod environments.
# The server will fail to start (crash-before-listen) if true in demo/prod.
MOCK_OAUTH_ENABLED=false

# ------------------------------------------------------------------------------
# 5. OAUTH PROVIDERS (100% Free / Zero SaaS Fees)
# ------------------------------------------------------------------------------
# Zalo Login (free developer account at developers.zalo.me)
ZALO_CLIENT_ID=
ZALO_CLIENT_SECRET=

# Google OAuth (Google Cloud Console OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login (Meta for Developers App ID / Secret)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL SETTINGS (Magic Link Authentication)
# ------------------------------------------------------------------------------
# Standard SMTP server configuration (e.g. self-hosted mailpit, postfix, or free SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cgp.local

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (VAPID Keys)
# ------------------------------------------------------------------------------
# Standard VAPID keys generated via webpush-go or npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
